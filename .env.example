# Kakomi の環境変数
#
# ローカル開発では何も設定しなくても動きます（DB は組み込みの PGlite、ファイルは .data/、メールは /dev/mail）。
# ここに書いた値は、Vercel の本番に入れるものです。Vercel の「Import .env」にそのまま使えるよう、
# 本番で要るものだけを有効な行にし、それ以外はコメントにしています。

# ─── 必須 ───────────────────────────────────────────────

# 2 段階認証の鍵を暗号化する鍵。openssl rand -base64 32 で作る。
# つなぐ DB と対にする（既存の DB を使うなら、その DB で使ってきた値と同じにする）。
# 失うと全員の 2 段階認証が使えなくなるので、DB とは別の場所に控える。Vercel では Sensitive に
MFA_ENCRYPTION_KEY=

# 毎日の定期処理（/api/cron/daily）の鍵。openssl rand -base64 32 で作る。Vercel では Sensitive に
CRON_SECRET=

# 利用規約・プライバシーポリシーに出す運営者名と問い合わせ先
OPERATOR_NAME=
CONTACT_EMAIL=

# ─── メール（どちらか一方） ─────────────────────────────

# A. メールを送らない：招待リンクと審査だけで入会する（パスワード再設定と通知メールは届かない）
EMAIL_VERIFICATION=off

# B. Resend で送る：下の 2 行を有効にして、上の EMAIL_VERIFICATION の行を消す
#    MAIL_FROM は Resend で認証したドメインにする
# RESEND_API_KEY=
# MAIL_FROM="Kakomi <no-reply@example.com>"

# ─── 自動で入る（手で入れない） ─────────────────────────
# DATABASE_URL / DATABASE_URL_UNPOOLED   … Vercel の Storage で Neon をつなぐと入る
# BLOB_READ_WRITE_TOKEN                  … Vercel の Storage で Blob（private）をつなぐと入る

# ─── 必要なときだけ ─────────────────────────────────────
# 独自ドメインを使うとき（未設定なら Vercel の本番ドメインを使う）
# APP_URL=https://kakomi.example.jp

# ─── Vercel には入れない ────────────────────────────────
# 最初の管理者を作るシード（scripts/seed.ts）を手元で流すときだけ、コマンドの前に付けて渡す
# OWNER_EMAIL= OWNER_PASSWORD= OWNER_NAME=
# Vercel 以外で動かすとき：ファイルの保存先（永続ボリューム）と、リバースプロキシの後ろなら 1
# UPLOAD_DIR=
# TRUST_PROXY=
