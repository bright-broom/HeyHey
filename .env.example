# 本番の PostgreSQL（未設定ならローカルの PGlite を使う）
DATABASE_URL=
# 公開 URL（https で始まると Cookie が Secure / __Host- になる）
APP_URL=http://localhost:3000
# 初回の npm run setup で作るオーナー
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
OWNER_NAME=オーナー
# メール送信（未設定なら /dev/mail の送信箱に溜まる）
RESEND_API_KEY=
MAIL_FROM="Kakomi <no-reply@example.com>"
# 画像の保存先
UPLOAD_DIR=
# 自前のリバースプロキシの後ろで動かすとき 1
TRUST_PROXY=
